{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ask-venkat-api",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["python_workers"],

  "ai": {
    "binding": "AI"
  },

  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "ask-venkat-knowledge"
    }
  ],

  "vars": {
    "ALLOWED_ORIGINS": "https://venkat-portfolio-website.venkateshwarreddy32.workers.dev"
  },

  "observability": {
    "enabled": true
  }
}
